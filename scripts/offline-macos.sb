;; T01 local compatibility lane. Native kernel enforcement is inherited by children.
;; This profile grants no external network destinations or Docker daemon socket.
(version 1)
(allow default)
(deny network*)
;; Do not delegate name resolution to a service outside the process boundary.
(deny mach-lookup
    (global-name "com.apple.mDNSResponder")
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.networkd")
    (global-name "com.apple.networkd_privileged")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration"))
(allow network-outbound
    (remote tcp "localhost:53000")  ;; local web health slice
    (remote tcp "localhost:58000")  ;; local API health slice
    (remote tcp "localhost:55432")  ;; local PostgreSQL
    (remote tcp "localhost:58080")  ;; local Keycloak
    (remote tcp "localhost:59000")  ;; public local S3 proxy
    (remote tcp "localhost:58333")) ;; alternate explicit public local S3 endpoint
;; Safe regression listeners bind only loopback; outbound access still needs a port grant.
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
;; Python multiprocessing/Chrome require local runtime IPC, not arbitrary daemon sockets.
(allow network*
    (remote unix-socket (path-prefix "/private/tmp/"))
    (local unix-socket (path-prefix "/private/tmp/"))
    (remote unix-socket (path-prefix "/private/var/folders/"))
    (local unix-socket (path-prefix "/private/var/folders/")))
