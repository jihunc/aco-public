#!/bin/sh
# Apply the inherited kernel boundary before Python, pytest plugins, or collection.
set -eu
cd "$(dirname "$0")/.."
if [ "$(uname -s)" != Darwin ] || [ ! -x /usr/bin/sandbox-exec ]; then
    echo 'Offline tests require the verified macOS native sandbox; use scripts/test-portable for the verified Linux/container lane.' >&2
    exit 2
fi
exec /usr/bin/sandbox-exec -f scripts/offline-macos.sb .venv/bin/python -m pytest "$@"
