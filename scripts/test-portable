#!/usr/bin/env python3
"""Trusted local Docker control plane; tests themselves receive no Docker IPC.

Build/pulls are a separate setup command. This runner uses a cached image only,
joins only the existing internal application network and installs a kernel
firewall before dropping all capabilities and executing any test/runtime code.
"""

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any
from urllib.parse import quote

from portable_manifest import verify_manifest

ROOT = Path(__file__).resolve().parents[1]


def docker(*args: str) -> str:
    return subprocess.check_output(["docker", *args], text=True, cwd=ROOT).strip()


def cached_image_manifest() -> tuple[str, dict[str, Any]]:
    """Read metadata without test startup, networking, mounts or startup hooks."""
    image = docker("image", "inspect", "aco-offline-t02:locked", "--format", "{{.Id}}")
    encoded = docker(
        "run",
        "--rm",
        "--pull",
        "never",
        "--network",
        "none",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges:true",
        "--read-only",
        "--user",
        "10001:10001",
        "--workdir",
        "/",
        image,
        "/usr/local/bin/python",
        "-I",
        "-S",
        "-c",
        "import sys;sys.stdout.write(open('/aco/.portable-inputs.json').read())",
    )
    embedded = json.loads(encoded)
    if not isinstance(embedded, dict):
        raise ValueError("Invalid portable manifest")
    return image, embedded


def main() -> int:
    if len(sys.argv) != 1:
        raise SystemExit("Fixed audited portable lane accepts no arbitrary commands")
    try:
        image, embedded = cached_image_manifest()
        verify_manifest(ROOT, embedded)
    except (subprocess.CalledProcessError, OSError, ValueError, TypeError):
        print(
            "BLOCKED: portable source/dependency correspondence missing or stale; explicit rebuild required",
            file=sys.stderr,
        )
        return 2
    print(f"Portable verified image: {image}; manifest: {embedded['digest']}", flush=True)
    network = json.loads(docker("network", "inspect", "aco_default"))[0]
    if network["Internal"] is not True:
        raise SystemExit("BLOCKED: application network must be internal-only")
    services = {}
    for service in ("postgres", "identity", "storage"):
        container = json.loads(docker("inspect", f"aco-{service}-1"))[0]
        if container["State"]["Status"] != "running":
            raise SystemExit(f"BLOCKED: {service} is not running")
        if service != "identity" and container["State"].get("Health", {}).get("Status") != "healthy":
            raise SystemExit(f"BLOCKED: {service} exposure gate is not healthy")
        services[service] = container["NetworkSettings"]["Networks"]["aco_default"]["IPAddress"]
    env = dict(
        line.split("=", 1)
        for line in (ROOT / ".env").read_text().splitlines()
        if line and not line.startswith("#") and "=" in line
    )
    password = quote(env["DATABASE_PASSWORD"], safe="")
    supplied = {
        "ACO_TEST_OIDC_CLIENT_SECRET": env["OIDC_CLIENT_SECRET"],
        "ACO_TEST_DEMO_PASSWORD": env["DEMO_PASSWORD"],
        "ACO_TEST_SESSION_SECRET": env["SESSION_SECRET"],
        "ACO_TEST_TOKEN_ENCRYPTION_KEY": env["TOKEN_ENCRYPTION_KEY"],
        "ACO_LOCAL_PG_IP": services["postgres"],
        "ACO_LOCAL_OIDC_IP": services["identity"],
        "ACO_LOCAL_S3_IP": services["storage"],
        "ACO_TEST_DATABASE_URL": f"postgresql+psycopg://aco:{password}@{services['postgres']}:5432/aco",
        "ACO_TEST_STORAGE_ENDPOINT": f"http://{services['storage']}:8333",
        "ACO_TEST_STORAGE_BUCKET": env.get("STORAGE_BUCKET") or "aco-artifacts",
        "ACO_TEST_STORAGE_APP_ACCESS_KEY": env["STORAGE_APP_ACCESS_KEY"],
        "ACO_TEST_STORAGE_APP_SECRET_KEY": env["STORAGE_APP_SECRET_KEY"],
        "ACO_TEST_OIDC_DISCOVERY_URL": f"http://{services['identity']}:8080/realms/aco/.well-known/openid-configuration",
        "ACO_TEST_OIDC_ISSUER": f"http://{services['identity']}:8080/realms/aco",
    }
    command = [
        "docker",
        "run",
        "--rm",
        "--pull",
        "never",
        "--network",
        "aco_default",
        "--cap-drop",
        "ALL",
        "--cap-add",
        "NET_ADMIN",
        "--cap-add",
        "SETUID",
        "--cap-add",
        "SETGID",
        "--cap-add",
        "SETPCAP",
        "--security-opt",
        "no-new-privileges:true",
        "--shm-size",
        "1g",
        "--dns",
        "127.0.0.1",
    ]
    for key in supplied:
        command.extend(("--env", key))
    command.extend((image, "/aco/infra/testing/lock-network.sh", "/aco/infra/testing/run-tests.sh"))
    return subprocess.call(command, cwd=ROOT, env={**os.environ, **supplied})


if __name__ == "__main__":
    raise SystemExit(main())
