# Fixed product upstreams only; no URL/CONNECT forwarding and no body/access logging.
server {
    listen 3000;
    server_name _;
    access_log off;
    error_log /dev/stderr crit;
    client_max_body_size 10m;
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
server {
    listen 8000;
    server_name _;
    access_log off;
    error_log /dev/stderr crit;
    client_max_body_size 10m;
    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
server {
    listen ${PRODUCT_IDENTITY_PORT};
    server_name identity.aco.localhost;
    access_log off;
    error_log /dev/stderr crit;
    location / {
        proxy_pass http://identity:8080;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
    }
}
