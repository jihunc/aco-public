;; New explicit product rehearsal. Existing native and portable policies are unchanged.
(version 1)
(allow default)
(deny network*)
(deny mach-lookup
    (global-name "com.apple.mDNSResponder")
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.networkd")
    (global-name "com.apple.networkd_privileged")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration"))
(allow network-outbound
    (remote tcp "localhost:53100")
    (remote tcp "localhost:58180"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network*
    (remote unix-socket (path-prefix "/private/tmp/"))
    (local unix-socket (path-prefix "/private/tmp/"))
    (remote unix-socket (path-prefix "/private/var/folders/"))
    (local unix-socket (path-prefix "/private/var/folders/")))
