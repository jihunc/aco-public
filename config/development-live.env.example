# No API keys in this file. Init produces all fake providers with the kill switch ON.
# Independently choose fake/openai, mock/resend, mock/vapi. Selection is not authority.
DEV_MODE=live
DEV_INFRA_CONFIG=/absolute/path/to/private/product.env
DEV_PROVIDER_DIRECTORY=/absolute/path/to/private/providers
# Real selections MUST mount the SAME retained canonical operator .tooling directory.
DEV_CAMPAIGN_DIRECTORY=/absolute/common/repository/.tooling
APP_ENV=local
ACCOUNTING_ADAPTER=demo
LLM_PROVIDER=fake
EMAIL_ADAPTER=mock
VOICE_ADAPTER=mock
OUTBOUND_ENABLED=false
AUTOMATION_KILL_SWITCH=true
# Add only the selectors required by each explicitly selected real adapter:
# LLM_PROVIDER=openai
# ACO_AGENT_LIVE_CONFIG_PATH=/run/aco/providers/openai.env
# ACO_AGENT_LIVE_GRANT_ID=<actual-current-persisted-grant-uuid>
# ACO_LIVE_AUTHORIZATION_REF=<separately-approved-reference>
# ACO_LIVE_CAMPAIGN_FILE=/var/lib/aco/live/live-delivery-2026-11-19.sqlite3
# ACO_LIVE_ALLOCATION_ID=<retained-canonical-allocation-uuid>
# EMAIL_ADAPTER=resend
# ACO_EMAIL_LIVE_CONFIG_PATH=/run/aco/providers/resend-selection.json
# ACO_DELIVERY_APPROVED_EMAIL_RECIPIENT=<exact-separately-approved-test-recipient>
# VOICE_ADAPTER=vapi
# ACO_VOICE_LIVE_CONFIG_PATH=/run/aco/providers/vapi-selection.json
