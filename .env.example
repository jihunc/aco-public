# Synthetic local setup only. Generate private random values; never commit .env.
APP_ENV=local
EXTERNAL_PROVIDERS=fake
ACCOUNTING_ADAPTER=demo
EMAIL_ADAPTER=mock
VOICE_ADAPTER=mock
LLM_PROVIDER=fake
# Server-only: an explicitly installed bounded synthetic live grant, never an API key.
# Both path and grant are required for explicit startup. No default private file is read.
ACO_AGENT_LIVE_CONFIG_PATH=
ACO_AGENT_LIVE_GRANT_ID=
# Current campaign authorization is mandatory for explicit normal startup; blank refuses selection.
# Operator controls only. Not frontend configuration; no credentials here.
ACO_LIVE_AUTHORIZATION_REF=
ACO_LIVE_CAMPAIGN_FILE=
ACO_LIVE_ALLOCATION_ID=
ACO_TEST_PROFILE=mock
ACO_DEPLOYED_ORIGIN=
OUTBOUND_ENABLED=false
AUTOMATION_KILL_SWITCH=true
RECORDING_ENABLED=false
TRANSCRIPTION_ENABLED=false
# Optional health checks. Supply a private local DSN, never a provider API credential.
DATABASE_URL=
STORAGE_ENDPOINT=http://127.0.0.1:59000
# Trusted local container control plane only; leave blank for native local use.
ACO_LOCAL_S3_IP=
OIDC_DISCOVERY_URL=http://127.0.0.1:58080/realms/aco/.well-known/openid-configuration
OIDC_ISSUER=http://127.0.0.1:58080/realms/aco
HEALTH_TIMEOUT_SECONDS=2
# Compose-only private local service credentials. Setup must fill all blank values.
DATABASE_PASSWORD=
# Admin/init only; never inject into API or worker runtime.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SSE_KEK=
STORAGE_BUCKET=aco-artifacts
# Independent bucket-scoped application identity. API/worker receive only these.
STORAGE_APP_ACCESS_KEY=
STORAGE_APP_SECRET_KEY=
# After private setup, render static identities with scripts/render_storage_config.py.
# Do not pass this entire control-plane .env as API/worker env_file.
KEYCLOAK_ADMIN_USER=aco-local-admin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
WEB_PUBLIC_URL=http://127.0.0.1:53000
OIDC_CLIENT_ID=aco
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=28800
DEMO_PASSWORD=

# Enables only the durable synthetic email runtime; persisted Owner review is also required.
SYNTHETIC_EMAIL_ENABLED=false

# Separate synthetic inbound capture; private APP storage and Owner activation also required.
SYNTHETIC_EMAIL_INGRESS_ENABLED=false
SYNTHETIC_EMAIL_INGRESS_WEBHOOK_SECRET=

# Explicit local/demo-only synthetic voice probe and signed callback simulator. No live calls.
SYNTHETIC_VOICE_ENABLED=false

# Optional explicit server-only email test configuration. Keep unset by default.
# Absolute owner-only 0600 JSON path; never store provider keys here or expose via NEXT_PUBLIC_.
ACO_EMAIL_LIVE_CONFIG_PATH=

# Optional server-only Voice private configuration selector; blank keeps it unselected.
# Absolute owner-only 0600 file path, never provider keys or NEXT_PUBLIC_ configuration.
ACO_VOICE_LIVE_CONFIG_PATH=

# Optional private operator approval pin for the separately authorized DELIVERY email lane.
# Blank refuses that lane; never forward to web/public/default application containers.
ACO_DELIVERY_APPROVED_EMAIL_RECIPIENT=
